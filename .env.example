OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional — used by the browser voice call feature for spoken replies.
# Defaults shown below; change OPENAI_TTS_VOICE to alloy/echo/fable/onyx/
# shimmer if you want a different voice for Deskie.
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Optional — used in production; if unset, a random dev key is generated
# once and cached to .dev_secret_key (already gitignored).
DJANGO_SECRET_KEY=

# Optional — chat rate limiting and history cap, sensible defaults if unset.
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW=60
CHAT_HISTORY_MAX_TURNS=10
CHAT_MESSAGE_MAX_CHARS=1000

# Optional — OpenAI request timeout (seconds) and retry count.
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

# Optional — escalation notifications. When the AI agent flags a chat with
# [ESCALATE], these fire so a human actually finds out. Both are off by
# default (safe to leave unset); set either or both to enable.
SUPPORT_NOTIFICATION_EMAIL=
SLACK_ESCALATION_WEBHOOK_URL=

# Optional — only needed if SUPPORT_NOTIFICATION_EMAIL is set and you want
# real email instead of console output. Defaults to printing emails to the
# terminal, which is fine for local dev.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@deskyard.local
